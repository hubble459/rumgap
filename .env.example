# HOST=127.0.0.1
HOST=0.0.0.0
PORT=8000
DATABASE_URL="postgres://postgres:postgres@localhost/rumgap"
# Update manga when fetched if not updated for longer than 1 hour
MANGA_UPDATE_INTERVAL_MS=3600000
# Check every 4 hours for updates
MANGA_AUTO_UPDATE_INTERVAL_MS=14400000
# Only update manga that havent been updated for 8 hours
MANGA_AUTO_UPDATE_MIN_INTERVAL_MS=28800000
MANGA_AUTO_UPDATE_MAX=10
FCM_LEGACY_API_KEY=<TOKEN HERE>

# Local image hosting (Phase 2)
# Where downloaded chapter page images are stored on disk
IMAGE_STORAGE_PATH=data/images
# Port for the standalone image HTTP server (separate from the gRPC PORT above)
IMAGE_PORT=8001
# Base URL clients use to reach the image server (reverse-proxied in production)
IMAGE_BASE_URL=http://localhost:8001
# How many chapter page images may download at once, process-wide
CHAPTER_IMAGE_DOWNLOAD_CONCURRENCY=4
# Pacing (not concurrency) between chapters during MangaSource.BackfillImages,
# jittered +/-500ms -- spreads a large backfill out over time so it doesn't
# look like scraper traffic
BACKFILL_CHAPTER_DELAY_MS=1500